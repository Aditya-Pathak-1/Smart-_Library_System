# -------------------------------------------------
# frontend/Dockerfile
# -------------------------------------------------
FROM node:20-alpine AS base

WORKDIR /app

# Install dependencies (use npm install because package-lock.json may not exist)
COPY package*.json ./
RUN npm install

# Copy the rest of the source
COPY . .

# Vite dev server listens on all interfaces
EXPOSE 5173

# Start Vite dev server (host 0.0.0.0 makes it reachable from Windows)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]