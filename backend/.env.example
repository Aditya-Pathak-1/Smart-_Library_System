# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_library
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/smart_library_test

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Smart Library System
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Library Settings (Defaults)
DEFAULT_BORROWING_DAYS=14
DEFAULT_FINE_PER_DAY=5.00
MAX_BOOKS_PER_MEMBER=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100